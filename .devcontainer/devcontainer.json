{
  "name": "MewCode",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "postCreateCommand": "pip install -e '.[dev]' || pip install --user -e '.[dev]'",
  "postAttachCommand": "echo 'MewCode ready: bash scripts/setup-codespace-config.sh && python -m mewcode'",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "remoteUser": "vscode"
}
